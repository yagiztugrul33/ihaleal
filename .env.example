# TODO(anahtar): Web Push (push-notifier Edge Function) icin VAPID anahtar cifti gerekir.
# Uretim: `npx web-push generate-vapid-keys` ile bir defaya mahsus uretilir.
# Public key istemciye (bu env var ile), private key SADECE Supabase Edge Function
# secret olarak eklenir (asla VITE_ ile client'a sizdirilmez).
VITE_VAPID_PUBLIC_KEY=BXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Supabase Dashboard -> Project Settings -> Edge Functions -> Secrets (VITE_ ONEKI KULLANMA):
#   VAPID_PUBLIC_KEY  = yukaridaki ile ayni deger
#   VAPID_PRIVATE_KEY = generate-vapid-keys cikisindaki private key
#   VAPID_SUBJECT     = mailto:info@ihaleal.com (varsayilan)
# Deploy: supabase functions deploy push-notifier

