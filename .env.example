# ihaleal.com — Supabase environment variables
# Bu dosya repoya commit'lenir; gerçek değerler .env.local'de
# Şablon: env.local.SABLON dosyasını kopyalayıp .env.local yapın.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxx
# Ödeme: yayında mock kalması için boş bırakın veya mock. Gerçek PSP kodu yazılana kadar "live" kullanmayın.
# VITE_PAYMENT_MODE=mock
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_PROJECT_REF=xxxxxxxxxxxxxxxxxxxx

# Vergi simülatörü — TCMB EVDS (Edge Function `tcmb_yiufe`):
# Supabase Dashboard → Project Settings → Edge Functions → Secrets:
#   TCMB_EVDS_API_KEY = https://evds2.tcmb.gov.tr/ ücretsiz API anahtarı
# İsteğe bağlı: TCMB_EVDS_SERIES (varsayılan TP.FG.J0 — Yİ-ÜFE genel seri kodu)
# Deploy: supabase functions deploy tcmb_yiufe
