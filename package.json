  "scripts": {
    "dev": "vite --host --open",
    "dev:mobile-url": "node scripts/dev-mobile-url.mjs",
    "build": "node scripts/vite-build-safe.mjs",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
