{
  "name": "ihaleal.com",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host --open",
    "dev:mobile": "vite --host 0.0.0.0 --port 5185 --strictPort",
    "dev:mobile:follow": "set VITE_DEV_PORT=5185&& npm run dev:mobile-url && npm run dev:mobile",
    "dev:mobile-url": "node scripts/dev-mobile-url.mjs",
    "build": "node scripts/vite-build-safe.mjs",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "gen:assets": "node scripts/gen-assets.mjs",
    "theme:luxury": "node scripts/run-gen-luxury.mjs",
    "env:sync": "node scripts/sync-vite-supabase-env.mjs",
    "sql:bundle": "node scripts/push-migrations.mjs",
    "supabase:link": "supabase link --project-ref wsjifesrdaeorrdzbvmk",
    "supabase:push": "supabase db push",
    "test": "vitest",
    "test:run": "vitest run",
    "test:integration:core": "vitest run tests/engineering/integration/coreIntegration.test.ts",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "playwright test",
    "test:smoke:install": "playwright install --with-deps chromium",
    "backup": "node scripts/backup.mjs",
    "precheck:encoding": "node scripts/check-source-encoding.mjs",
    "lint": "npx eslint . --max-warnings 0",
    "lint:ci": "npx eslint src/lib/runtimeFlags.ts src/lib/localSession.ts src/lib/payment src/lib/supabase.ts src/components/admin src/components/LocalAuthGate.tsx src/components/ProductionSafetyBanner.tsx tests/rls scripts/validate-build-env.mjs scripts/generate-rls-matrix.mjs --max-warnings 0",
    "validate:env": "node scripts/validate-build-env.mjs",
    "validate:env:strict": "node scripts/validate-build-env.mjs --strict",
    "security:audit": "npm audit --audit-level=high",
    "rls:matrix": "node scripts/generate-rls-matrix.mjs",
    "test:rls": "vitest run tests/rls/policy-contract.test.ts",
    "test:rls:live": "vitest run tests/rls/integration.harness.test.ts",
    "test:core": "node tests/core.test.cjs",
    "verify": "npm run typecheck && npm run precheck:encoding && npm run validate:env && npm run test:core && npm run test:run && npm run build",
    "verify:ci": "npm run verify && npm run test:rls && npm run test:coverage && node scripts/check-bundle-budget.mjs && npm run lint:ci && npm run security:audit",
    "precheck:supabase": "node scripts/precheck-supabase.mjs",
    "site:finish": "cmd /c CALISTIR_SITEYI_BITIR.bat",
    "site:finish:all": "cmd /c SITE_BITIR_TEK_CALISTIR.bat",
    "site:finish:ci": "cmd /c BITIR_VERIFY_CI.bat",
    "postinstall": "node scripts/postinstall-rollup.mjs",
    "build:full": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.0",
    "@radix-ui/react-dialog": "^1.1.11",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.4",
    "@radix-ui/react-slider": "^1.3.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.2.6",
    "@sentry/react": "^10.54.0",
    "@supabase/supabase-js": "^2.106.2",
    "@types/leaflet": "^1.9.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.12",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.15.1",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.3.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.1.0",
    "postcss": "^8.5.3",
    "sharp": "^0.34.1",
    "supabase": "^2.95.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.5"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.60.3",
    "@rollup/rollup-linux-x64-musl": "4.60.3"
  }
}
