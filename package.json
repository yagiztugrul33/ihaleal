    "validate:env:strict": "node scripts/validate-build-env.mjs --strict",
    "security:audit": "npm audit --audit-level=high",
    "rls:matrix": "node scripts/generate-rls-matrix.mjs",
    "test:rls": "vitest run tests/rls/policy-contract.test.ts",
    "test:rls:live": "vitest run tests/rls/integration.harness.test.ts",
    "test:core": "node tests/core.test.cjs",
    "verify": "npm run typecheck && npm run precheck:encoding && npm run validate:env && npm run test:core && npm run test:run && npm run build",
    "verify:ci": "npm run verify && npm run test:rls && npm run test:coverage && node scripts/check-bundle-budget.mjs && npm run lint:ci && npm run security:audit",
    "precheck:supabase": "node scripts/precheck-supabase.mjs",
    "site:finish": "cmd /c CALISTIR_SITEYI_BITIR.bat",
    "site:finish:all": "cmd /c SITE_BITIR_TEK_CALISTIR.bat",
    "site:finish:ci": "cmd /c BITIR_VERIFY_CI.bat",
    "postinstall": "node scripts/postinstall-rollup.mjs",
    "build:full": "tsc --noEmit && vite build",
    "tema:uyum": "node scripts/gen-tema-uyum.mjs src/styles/global-acik.css src"
  },
