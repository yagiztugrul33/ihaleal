# ihaleal.com — production / Vercel environment template
# Copy keys to Vercel Project Settings → Environment Variables (Production).
# Never commit real secrets.

# Supabase (required)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Auth — local demo login MUST stay off in production
VITE_ALLOW_LOCAL_AUTH=false

# Payments — mock blocked in production builds; use only after PSP audit
# VITE_PAYMENT_MODE=mock
# VITE_PAYMENT_MODE=live

# Observability (optional)
# VITE_SENTRY_DSN=https://xxx@o000.ingest.sentry.io/000

# Edge Functions (Supabase secrets, not VITE_)
# ALLOWED_ORIGINS=https://ihaleal.vercel.app,https://ihaleal.com
# PAYTR_MERCHANT_ID=...
# PAYTR_MERCHANT_KEY=...
# PAYTR_MERCHANT_SALT=...
